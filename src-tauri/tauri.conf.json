{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuildBook",
  "version": "0.4.0-test.13",
  "identifier": "com.buildbook.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BuildBook",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http: https:; media-src 'self' asset: http://asset.localhost data: blob:; frame-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* http://[::1]:* http: https:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "../dist"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MkU4NkJCMzQxRTM2NkQKUldSdE5oNDB1NFl1NUUyaVo1dnFyQTkvMXh4S3JVNEl5LzNyc0loZjh6Z0RPVmUrK1JGamJOVHEK",
      "endpoints": [
        "https://github.com/illerin/BuildBook/releases/download/test-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

